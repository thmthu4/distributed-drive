from flask import Flask, request, redirect, session, send_file, render_template_string
from werkzeug.security import generate_password_hash, check_password_hash
import sqlite3, io, math, requests

# ---------- Config ----------
WEBAPP_DB = "webapp.db"

# Metadata server URL (change to your metadata VM IP if webapp runs elsewhere)
META_URL = "https://127.0.0.1:5000"

# For now (dev): don't verify certs; later set to path to ca.crt
META_VERIFY = False

BLOCK_SIZE = 64 * 1024
REPL_FACTOR = 2
ADMIN_TOKEN = "admin-secret"

# ---------- App ----------
app = Flask(__name__)
app.secret_key = "change-this-secret"

# ---------- DB ----------
def db():
    conn = sqlite3.connect(WEBAPP_DB)
    conn.row_factory = sqlite3.Row
    return conn

def init_db():
    conn = db()
    conn.execute("""CREATE TABLE IF NOT EXISTS users(
        username TEXT PRIMARY KEY,
        password_hash TEXT NOT NULL
    )""")
    conn.execute("""CREATE TABLE IF NOT EXISTS uploads(
        username TEXT NOT NULL,
        file_id TEXT NOT NULL,
        filename TEXT NOT NULL,
        size INTEGER NOT NULL,
        created REAL DEFAULT (strftime('%s','now')),
        PRIMARY KEY(username, file_id)
    )""")
    conn.commit()
    conn.close()

def current_user():
    return session.get("u")

def login_required():
    return current_user() is not None

# ---------- HTML ----------
LOGIN_HTML = """
<h2>Secure DFS Web App</h2>
{% if msg %}<p style="color:red">{{msg}}</p>{% endif %}
<form method="post">
  <input name="username" placeholder="username" required>
  <input name="password" type="password" placeholder="password" required>
  <button name="action" value="login">Login</button>
  <button name="action" value="register">Register</button>
</form>
"""

DASH_HTML = """
<h2>Welcome, {{user}}</h2>
<p>
  <a href="/cluster">Cluster Status</a> |
  <a href="/logout">Logout</a>
</p>
<hr>
